// Hillvary — Christian clothing ministry storefront + admin CMS

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  FAILED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("categories")
}

model Size {
  id        String        @id @default(cuid())
  label     String        @unique
  sortOrder Int           @default(0)
  products  ProductSize[]

  @@map("sizes")
}

model Color {
  id       String         @id @default(cuid())
  name     String         @unique
  hexCode  String
  products ProductColor[]

  @@map("colors")
}

model Product {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  description      String
  designDetails    String[] @default([])
  price            Int
  discountPrice    Int?
  currency         String   @default("FRW")
  brand            String   @default("Hillvary")
  material         String?
  careInstructions String?
  sku              String   @unique
  stockQuantity    Int      @default(0)
  featured         Boolean  @default(false)
  newArrival       Boolean  @default(false)
  active           Boolean  @default(true)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  images ProductImage[]
  sizes  ProductSize[]
  colors ProductColor[]

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([featured])
  @@index([newArrival])
  @@index([active])
  @@map("products")
}

model ProductImage {
  id       String  @id @default(cuid())
  url      String
  publicId String
  position Int     @default(0)
  alt      String?

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductSize {
  productId String
  sizeId    String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      Size    @relation(fields: [sizeId], references: [id], onDelete: Cascade)

  @@id([productId, sizeId])
  @@map("product_sizes")
}

model ProductColor {
  productId String
  colorId   String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  color     Color   @relation(fields: [colorId], references: [id], onDelete: Cascade)

  @@id([productId, colorId])
  @@map("product_colors")
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  customerName    String
  customerEmail   String
  customerPhone   String?
  shippingAddress String?
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(UNPAID)
  subtotal        Int
  total           Int
  currency        String        @default("FRW")
  items           OrderItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String
  size      String?
  color     String?
  quantity  Int
  price     Int

  @@index([orderId])
  @@map("order_items")
}

model Settings {
  id           String  @id @default("singleton")
  siteName     String  @default("Hillvary")
  contactEmail String?
  contactPhone String?
  whatsappUrl  String?
  instagramUrl String?
  tiktokUrl    String?
  storeAddress String?
  aboutText    String?

  @@map("settings")
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  createdAt DateTime @default(now())

  @@map("contact_messages")
}
